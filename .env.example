# ============================================
# SMART FUND - Environment Configuration
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_fund

# JWT Secret
JWT_SECRET=smartfund_super_secret_key_change_this_2026
JWT_EXPIRES_IN=7d

# Session Secret
SESSION_SECRET=smartfund_session_secret_2026

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_ADMIN_CHAT_ID=YOUR_ADMIN_CHAT_ID_HERE
TELEGRAM_BOT_USERNAME=smartfundonline_bot

# Admin Default Account (created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_EMAIL=admin@smartfund.id
ADMIN_FULL_NAME=Super Admin

# Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# CORS
CORS_ORIGIN=*