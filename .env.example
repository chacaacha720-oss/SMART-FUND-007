# ============================================
# SMART FUND - Environment Configuration
# Railway Deploy Ready
# Copy this file to .env and update values
# ============================================

# Server Configuration
PORT=

# Database Configuration (MySQL)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Railway MySQL Plugin (otomatis tersedia, tidak perlu diisi manual)
# DATABASE_URL=mysql://user:pass@host:port/database
# MYSQL_PRIVATE_URL=mysql://user:pass@host:port/database
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

# JWT Secret
JWT_SECRET=smartfund_super_secret_key_change_this_2026
JWT_EXPIRES_IN=7d

# Session Secret
SESSION_SECRET=smartfund_session_secret_2026

# Site URL (untuk link Telegram & absolute URL)
# Contoh Railway: https://smart-fund-production.up.railway.app
SITE_URL=

# Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# CORS
CORS_ORIGIN=*

# Telegram Bot Configuration (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_BOT_USERNAME=smartfundonline_bot

# Admin Default Account (dibuat saat db:init pertama kali)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_EMAIL=admin@smartfund.id
ADMIN_FULL_NAME=Super Admin